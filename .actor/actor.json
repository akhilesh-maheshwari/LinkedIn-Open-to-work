{
  "actorSpecification": 1,
  "name": "linkedin-open-to-work-status",
  "title": "LinkedIn Open To Work Status",
  "description": "Check Open To Work status for LinkedIn profiles in bulk. No LinkedIn cookies required.",
  "version": "1.0",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn Open To Work Status Output",
    "description": "LinkedIn profile data including name, headline, location, and Open To Work status.",
    "properties": {
      "results": {
        "type": "string",
        "title": "LinkedIn Profiles",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "publicIdentifier",
              "linkedInIdentifier",
              "memberIdentifier",
              "linkedInUrl",
              "firstName",
              "lastName",
              "headline",
              "summary",
              "email",
              "location",
              "followerCount",
              "premium",
              "is_open_profile",
              "is_creator",
              "is_influencer",
              "is_self",
              "is_relationship",
              "is_hiring",
              "is_open_to_work",
              "websites",
              "connections_count",
              "birthdate",
              "positions",
              "schools",
              "skills",
              "languages",
              "recommendations",
              "volunteering_experience",
              "photoUrl",
              "backgroundUrl",
              "request_type",
              "open_to_work_status"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
