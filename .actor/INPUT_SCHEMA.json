{
  "title": "LinkedIn Open To Work Status",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "fileName": {
      "title": "File Name / Tag",
      "type": "string",
      "description": "A label for this run.",
      "editor": "textfield",
      "default": "OTW_Run"
    },
    "profiles": {
      "title": "LinkedIn Profile URLs",
      "type": "array",
      "description": "LinkedIn profile URLs to check Open To Work status.",
      "editor": "stringList",
      "prefill": [
        "https://www.linkedin.com/in/ajjames"
      ]
    }
  },
  "required": ["fileName", "profiles"]
}
